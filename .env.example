PORT=3000
NODE_ENV=development

# SMTP Яндекса. Используйте пароль приложения, а не основной пароль аккаунта.
SMTP_HOST=smtp.yandex.com
SMTP_PORT=465
SMTP_USER=sagatel.petrosyan
SMTP_PASS=replace-with-yandex-app-password
SMTP_FROM=sagatel.petrosyan@yandex.com
MAIL_TO=sagatel.petrosyan@yandex.com

# Укажите адрес сайта после публикации, например https://example.ru
ALLOWED_ORIGINS=

# Включите только за доверенным reverse proxy (Render, Railway, nginx и т. п.).
TRUST_PROXY=0
